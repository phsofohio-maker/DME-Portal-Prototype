# ─── Firebase Configuration ───────────────────────────────────────────────────
# Copy this file to .env.local and fill in values from your Firebase Console.
# IMPORTANT: .env.local is git-ignored — never commit real keys to the repo.
#
# Steps:
#   1. Go to console.firebase.google.com → Your Project → Project Settings → General
#   2. Under "Your apps", copy the firebaseConfig object values below.
#   3. Ensure the Google Cloud BAA is signed BEFORE storing any PHI.

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
