{
  "name": "parrish-dme-functions",
  "description": "Parrish Health DME Portal — Firebase Cloud Functions",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "scripts": {
