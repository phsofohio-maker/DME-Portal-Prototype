rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── Staff profiles ─────────────────────────────────────────────────────
    // All authenticated staff can read any profile (needed for messaging, requests).
    // Only admins can create accounts; each user can update their own profile.
    // No hard deletes — use status: 'suspended' instead (HIPAA record retention).

    match /staff/{uid} {
      allow read:   if isSignedIn();
      allow create: if isAdmin();
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if false;
    }

    // ── Login history (subcollection of staff) ─────────────────────────────
    // Each user can write their own login events; admin can read all.

    match /staff/{uid}/loginHistory/{entryId} {
      allow read:   if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if false;
      allow delete: if false;
    }

    // ── Invitations ────────────────────────────────────────────────────────

    match /invitations/{id} {
      allow read:   if isAdmin();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── Requests ───────────────────────────────────────────────────────────
    // All staff can read and submit requests.
    // Only admins can update status (approve / deny / RMI).
    // No deletes.

    match /requests/{id} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── Communications (messages) ──────────────────────────────────────────
    // Only the two participants (or an admin) can read a message thread.
    // Any authenticated user can send a message (create).
    // Recipient can mark a message as read (update); no other client updates.

    match /communications/{id} {
      allow read:   if isAdmin() ||
                       (isSignedIn() &&
                        (resource.data.senderId    == request.auth.uid ||
                         resource.data.recipientId == request.auth.uid));
      allow create: if isSignedIn();
      allow update: if isSignedIn() &&
                       resource.data.recipientId == request.auth.uid;
      allow delete: if false;
    }

    // ── Conversation encryption keys ───────────────────────────────────────
    // Per-conversation AES-GCM keys. Only the two participants may read/create.
    // Keys are never updated once set.

    match /conversationKeys/{id} {
      allow read:   if isSignedIn() &&
                       request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() &&
                       request.auth.uid in request.resource.data.participants;
      allow update: if false;
      allow delete: if false;
    }

    // ── Notifications ──────────────────────────────────────────────────────
    // Each user can read and mark-read their own notifications.
    // Cloud Functions write these server-side (admin SDK bypasses rules).

    match /notifications/{id} {
      allow read:   if isSignedIn() &&
                       resource.data.recipientId == request.auth.uid;
      allow create: if isAdmin();
      allow update: if isSignedIn() &&
                       resource.data.recipientId == request.auth.uid;
      allow delete: if false;
    }

    // ── Audit log ──────────────────────────────────────────────────────────
    // Append-only from Cloud Functions; admin-only read. No client writes.

    match /audit_log/{id} {
      allow read:   if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // ── DME catalog ────────────────────────────────────────────────────────
    // Read-only for all authenticated staff. Writable only by admin.

    match /dme_catalog/{id} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Patients ───────────────────────────────────────────────────────────
    // All staff can read; admin can write (Phase 4 will add HL7 FHIR import).

    match /patients/{id} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Mail (Trigger Email extension) ─────────────────────────────────────
    // Cloud Functions write to this collection via admin SDK — no client access.

    match /mail/{id} {
      allow read:   if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}
